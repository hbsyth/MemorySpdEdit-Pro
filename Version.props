<!--
  Version rule: Ver + YY + . + ISO-week(WW) + . + serial(NNNN)
  Example: Ver26.38.0001
  Bump only when publishing package to GitHub (scripts/Publish-Release.ps1).
  Current: Ver26.38.0002
-->
<Project>
  <PropertyGroup>
    <AppVersionYear>26</AppVersionYear>
    <AppVersionWeek>38</AppVersionWeek>
    <AppVersionSerial>2</AppVersionSerial>
    <AppVersionLabel>Ver26.38.0002</AppVersionLabel>
    <Version>26.38.2</Version>
    <AssemblyVersion>26.38.2.0</AssemblyVersion>
    <FileVersion>26.38.2.0</FileVersion>
    <InformationalVersion>Ver26.38.0002</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
